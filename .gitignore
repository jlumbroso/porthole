# macOS metadata
.DS_Store

# Publishing credentials live here, typed with a plain editor and never committed
# (the marketplace playbook, section IV; see docs/release/REPO-HYGIENE.md)
.env
.env.*
!.env.example

# Temporary files
~*

# pneumatic local state (edge ledger, recruit scripts) — machine-local, never substrate
.pneumatic/

# Spike run output (the log and the stamped page copy)
spike/.run/

# Extension build output and packages
node_modules/
releases/
dist/
out/
*.vsix
.vscode-test/

# Test coverage report (npm run test:coverage; the Vitest extension's coverage run)
coverage/

# Python temporary files
__pycache__/
*.py[cod]

# ADR Manager working files: backups (redundant, useful locally) and the error report
# the Manager team collects (decided 2026-10-13, ADR-0011). The drafts themselves stay tracked.
docs/adr/.working/*.bak
docs/adr/.working/errors.jsonl
