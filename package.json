{
  "name": "porthole",
  "displayName": "Porthole",
  "description": "Pop the HTML page or Markdown file you are looking at into a floating window: only the rendered page, pinned above your other windows.",
  "publisher": "jlumbroso",
  "icon": "media/icon.png",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jlumbroso/porthole"
  },
  "homepage": "https://github.com/jlumbroso/porthole#readme",
  "bugs": {
    "url": "https://github.com/jlumbroso/porthole/issues"
  },
  "keywords": [
    "html",
    "integrated browser",
    "floating window",
    "always on top",
    "pin",
    "preview",
    "task page",
    "checklist"
  ],
  "galleryBanner": {
    "color": "#B5A642",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Porthole opens local HTML files in VS Code's integrated browser, which reads them from disk."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "markdown.previewStyles": [
      "./media/markdown-color-scheme.css"
    ],
    "commands": [
      {
        "command": "porthole.popOut",
        "title": "Pop Out to Floating Window",
        "category": "Porthole",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "porthole.dockBack",
        "title": "Dock Back into Main Window",
        "category": "Porthole"
      },
      {
        "command": "porthole.cycleSize",
        "title": "Cycle Window Size",
        "category": "Porthole"
      },
      {
        "command": "porthole.togglePin",
        "title": "Toggle Always on Top",
        "category": "Porthole"
      },
      {
        "command": "porthole.reviewSettings",
        "title": "Review and Reset Settings…",
        "category": "Porthole"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "porthole.dockBack",
          "when": "isAuxiliaryWindowFocusedContext"
        },
        {
          "command": "porthole.cycleSize",
          "when": "isAuxiliaryWindowFocusedContext"
        },
        {
          "command": "porthole.togglePin",
          "when": "isAuxiliaryWindowFocusedContext"
        }
      ],
      "editor/title": [
        {
          "command": "porthole.popOut",
          "group": "navigation",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(html?|md|markdown)$/i && !isAuxiliaryWindowFocusedContext"
        }
      ],
      "editor/title/context": [
        {
          "command": "porthole.popOut",
          "group": "navigation@30",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(html?|md|markdown)$/i"
        }
      ],
      "explorer/context": [
        {
          "command": "porthole.popOut",
          "group": "navigation@30",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(html?|md|markdown)$/i"
        }
      ]
    },
    "keybindings": [
      {
        "command": "porthole.popOut",
        "key": "ctrl+alt+m",
        "when": "resourceScheme == file && resourceExtname =~ /^\\.(html?|md|markdown)$/i && activeEditor != 'workbench.editor.browser' && activeEditor != 'vscode.markdown.preview.editor' && !isAuxiliaryWindowFocusedContext"
      },
      {
        "command": "porthole.dockBack",
        "key": "ctrl+alt+m",
        "when": "isAuxiliaryWindowFocusedContext"
      }
    ],
    "configuration": {
      "title": "Porthole",
      "properties": {
        "porthole.sizes": {
          "type": "array",
          "markdownDescription": "Size presets for the floating window. A page pops out at the first preset; **Cycle Window Size** steps through the rest. VS Code will not make a window smaller than 400×270.",
          "default": [
            {
              "name": "S",
              "width": 420,
              "height": 640
            },
            {
              "name": "M",
              "width": 480,
              "height": 720
            },
            {
              "name": "L",
              "width": 640,
              "height": 900
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "width": {
                "type": "number",
                "minimum": 400
              },
              "height": {
                "type": "number",
                "minimum": 270
              }
            }
          }
        },
        "porthole.position": {
          "type": [
            "object",
            "null"
          ],
          "markdownDescription": "Where the floating window opens, in screen pixels, for example `{ \"x\": 40, \"y\": 80 }`. Leave as `null` to let VS Code center it on the current window.",
          "default": null,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "porthole.compact": {
          "type": "boolean",
          "default": true,
          "description": "Open the floating window in compact mode: no tabs, breadcrumbs or status bar."
        },
        "porthole.alwaysOnTop": {
          "type": "boolean",
          "default": true,
          "description": "Open the floating window pinned above other windows."
        },
        "porthole.markdown.colorScheme": {
          "type": "string",
          "enum": ["auto", "light", "dark"],
          "enumDescriptions": [
            "Follow VS Code's color theme, like any Markdown preview.",
            "Show Markdown in Porthole's floating windows with light colors, whatever VS Code's theme.",
            "Show Markdown in Porthole's floating windows with dark colors, whatever VS Code's theme."
          ],
          "default": "auto",
          "markdownDescription": "Colors of Markdown files shown in Porthole's floating windows. Other Markdown previews keep following VS Code's theme. Code-block syntax colors still follow VS Code's theme."
        },
        "porthole.askToKeepCompact": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Ask, at the first pop-out of each session, whether VS Code may lock Porthole's floating windows to one tab (by turning on `workbench.editor.autoLockGroups` for the integrated browser and the Markdown preview). Choosing **Don't Ask Again** sets this to `false`."
        },
        "porthole.useInternalCommand": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open the floating window with one internal VS Code command, at the exact preset size. That command is undocumented and may change in any VS Code update; Porthole then falls back on its own. Turn this off to use public commands only: the window opens at VS Code's default size, and size presets do not apply."
        }
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "check:package": "node scripts/check-package-contents.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:package",
    "package": "mkdir -p releases && vsce package --out releases/",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.134.0",
    "@vitest/coverage-v8": "5.0.4",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "1.2.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    }
  }
}
